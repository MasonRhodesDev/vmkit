#!/usr/bin/env bash
# vmkit — drive a QEMU VM as an agent: serial console, QMP control, framebuffer
# vision (screendump -> PPM -> PNG), keyboard, mouse, and a timestamped
# recording timeline (record/frames/check/report). Guest-OS-agnostic: it works
# at the QEMU layer (framebuffer, input, serial, QMP), not through anything the
# guest installs, so the same commands drive Linux, BSD, Windows, an installer
# ISO, or a kernel that never reaches userspace.
#
# Host needs: qemu-system-<arch>, python3 (stdlib only), openssh. Optional:
# ImageMagick (shot --grid, wait screen/watch fuzzy-diff, check template),
# tesseract+langpack (find/tap-text/check ocr), ffmpeg (record), a VNC client
# (view), curl (image pull). See README for the full dependency table.
#
# Config resolves from flags, then env, then defaults:
#   --overlay PATH     VMKIT_OVERLAY     disk image to boot (required for `up`)
#   --cidata PATH      VMKIT_CIDATA      optional seed ISO (cloud-init, etc.)
#   --dir PATH         VMKIT_DIR         work dir for sockets/logs/shots
#                                        (default: <overlay-dir>/.vmkit)
#   --ssh-port N       VMKIT_SSH_PORT    host port forwarded to guest :22 (2222)
#   --ssh-user U       VMKIT_SSH_USER    ssh user (default: current $USER)
#   --ssh-key PATH     VMKIT_SSH_KEY     ssh identity (~/.ssh/id_ed25519)
#   --mem MB           VMKIT_MEM         guest RAM MiB (4096)
#   --smp N            VMKIT_SMP         vcpus (4)
#   --arch A           VMKIT_ARCH        qemu-system-<A> (x86_64 default)
#   --accel A          VMKIT_ACCEL       kvm (default) | tcg
#   --vnc N            VMKIT_VNC         also expose VNC on 127.0.0.1:590N
#   --nice N           VMKIT_NICE        nice level for qemu/recorder (19)
#   --ionice C         VMKIT_IONICE      ionice class for qemu/recorder (3 = idle;
#                                        "none" to skip)
#   --qemu-arg ARG     VMKIT_QEMU_ARGS   extra qemu argv, appended last (flag is
#                                        repeatable; the env var is split with
#                                        shell quoting rules, via python shlex)
#
# Collaboration: start with `--view vnc` so the agent (QMP: shot/keys/mouse) and
# the human (a VNC client) drive the SAME running VM together. `vmkit view` opens
# the human's viewer. `--view gtk` is a native window but only when vmkit is run
# from a graphical shell; `--view none` (default) is agent-only headless.
#
# Commands:
#   up                       boot with serial+QMP; view per --view (none|vnc[:N]|gtk).
#                            Two QMP sockets: qmp.sock (every vmkit command) and
#                            qmp-rec.sock (reserved for the long-lived recorder;
#                            a QMP socket serves one client at a time)
#   view                     open a VNC client to the shared view (human side)
#   status                   sockets, ssh reachability, run-state
#   shot [name] [--grid]     screendump -> <dir>/<name>.png; --grid overlays a
#                            coordinate ruler so tap targets can be read off
#   find [TEXT] [--line]     OCR the screen -> "x,y<TAB>text" per match (word or
#                            grouped line); pick a `tap` target (needs tesseract)
#   tap-text "LABEL" [n] [btn]  OCR-locate a label (consecutive word run) and click it
#   move X Y                 move pointer to pixel (X,Y)
#   click [left|right|middle]  click at the current pointer position
#   tap X Y [button]         move to (X,Y) then click
#   drag X1 Y1 X2 Y2 [btn]   press-move-release
#   scroll up|down [n]       wheel scroll n notches
#   keys K [K...]            send QMP qcodes (e.g. ret esc tab shift-1 ctrl-alt-f2)
#   type TEXT                type an ASCII string
#   wait ssh|exec|xexec|serial|screen [args] [timeout]
#                            block until: ssh reachable | a guest cmd exits 0 |
#                            a cmd in the graphical session exits 0 |
#                            the serial log matches a regex | the frame is stable
#   push LOCAL GUEST-DEST    scp + sudo-install a file into the guest
#   pull GUEST-PATH LOCAL    copy a file out of the guest
#   xexec CMD...             run CMD in the guest's graphical (systemd --user) session
#                            (ssh/xexec: one arg = a shell command line; several
#                            args = an argv, each quoted with printf %q)
#   watch [timeout]          emit a line whenever the screen changes (motion)
#   overlay new BASE [OVL]   create a qcow2 overlay backed by BASE
#   overlay reset [OVL]      recreate an overlay from its backing image
#   image pull URL [DEST]    fetch a base image (needs curl)
#   serial [N]               print last N lines of the serial/console log (default 60)
#   ssh [CMD...]             ssh into the guest (interactive if no CMD; quoting as xexec)
#   qmp JSON                 raw QMP command object; prints the JSON reply
#   hmp LINE                 HMP command via human-monitor-command; prints its text
#   snapshot NAME            qcow2 internal snapshot (HMP savevm)
#   restore NAME             load a snapshot (HMP loadvm; needs the same devices)
#   snapshots                list snapshots (HMP info snapshots)
#   record start|stop|status  frame recorder (lib/vmkit/record.py) on qmp-rec.sock:
#                            start [--fps N] [--out RUNDIR] -> prints the run dir
#                            (frames.jsonl, frames/%06d.png, video.mkv, summary.json);
#                            input actions meanwhile also go to <run>/actions.jsonl
#   frames (--at T_NS | --action '#N'|STEP [--anchor send|ack]) --offset SPEC[,..]
#                            [--run DIR] [--baseline] [--json]: frames chosen by
#                            the schema's Timing rules (+100ms = first frame at or
#                            after; +0ms..+400ms = every frame in the window; an
#                            empty window is an error, exit 2)
#   check pixel|ocr|template|changed ... | check batch EXPECT.json
#                            model-free checks on frames (explicit --frame, or
#                            chosen from the recording like `frames`); JSON out,
#                            exit 0 pass / 1 fail / 2 error. See bin/vmkit-check -h
#   report [RUN] [--results FILE] [-o OUT]
#                            report.html: per-action contact sheets with check
#                            regions outlined, pass/fail summary, fps/degraded
#   down                     graceful powerdown; waits on the qemu pid (up to
#                            VMKIT_DOWN_TIMEOUT s, default 60), then TERM/KILL
#
# vmkit never uses `pkill -f` (its pattern would match the caller's own shell);
# it tracks the qemu pid in <dir>/qemu.pid and acts on that.
set -euo pipefail

# tesseract's OpenMP threads spin against each other on a busy host: one OCR
# pass took 90 s on a loaded 12-core box and 1.6 s with a single thread. One
# frame is small work, so default to one thread; a caller's setting wins.
export OMP_THREAD_LIMIT="${OMP_THREAD_LIMIT:-1}"

# ---- config resolution -------------------------------------------------------
OVERLAY="${VMKIT_OVERLAY:-}"; CIDATA="${VMKIT_CIDATA:-}"; DIR="${VMKIT_DIR:-}"
SSH_PORT="${VMKIT_SSH_PORT:-2222}"; SSH_USER="${VMKIT_SSH_USER:-$USER}"
SSH_KEY="${VMKIT_SSH_KEY:-$HOME/.ssh/id_ed25519}"
MEM="${VMKIT_MEM:-4096}"; SMP="${VMKIT_SMP:-4}"
ARCH="${VMKIT_ARCH:-x86_64}"; ACCEL="${VMKIT_ACCEL:-kvm}"
# VIEW controls the human-facing display: none (agent-only, headless),
# vnc[:N] (shared live view — agent drives QMP, human attaches a VNC client to
# the SAME running VM), or gtk (a native window; only works when vmkit is run
# from a graphical shell). vnc is the collaborative default recommendation.
VIEW="${VMKIT_VIEW:-none}"
# CPU/IO priority for qemu (and the recorder): nice level and ionice class
# (3 = idle; "none" skips ionice). The host may be someone's desktop.
NICE="${VMKIT_NICE:-19}"; IONICE="${VMKIT_IONICE:-3}"
# Extra qemu arguments, appended last so they can override: --qemu-arg ARG
# (repeatable, one argv element each) and/or VMKIT_QEMU_ARGS (split like a
# shell would, by python shlex: quotes group, newlines separate).
QEMU_EXTRA=()
if [ -n "${VMKIT_QEMU_ARGS:-}" ]; then
    qa=$(python3 -c 'import shlex, sys; print(" ".join(map(shlex.quote, shlex.split(sys.argv[1]))))' "$VMKIT_QEMU_ARGS" 2>/dev/null) \
        || { echo "vmkit: cannot parse VMKIT_QEMU_ARGS (shell quoting): $VMKIT_QEMU_ARGS" >&2; exit 2; }
    eval "QEMU_EXTRA=($qa)"
fi

args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --overlay) OVERLAY="$2"; shift 2;;
        --cidata) CIDATA="$2"; shift 2;;
        --dir) DIR="$2"; shift 2;;
        --ssh-port) SSH_PORT="$2"; shift 2;;
        --ssh-user) SSH_USER="$2"; shift 2;;
        --ssh-key) SSH_KEY="$2"; shift 2;;
        --mem) MEM="$2"; shift 2;;
        --smp) SMP="$2"; shift 2;;
        --view) VIEW="$2"; shift 2;;
        --vnc) VIEW="vnc:$2"; shift 2;;
        --arch) ARCH="$2"; shift 2;;
        --accel) ACCEL="$2"; shift 2;;
        --nice) NICE="$2"; shift 2;;
        --qemu-arg) QEMU_EXTRA+=("$2"); shift 2;;
        --ionice) IONICE="$2"; shift 2;;
        --) shift; args+=("$@"); break;;
        *) args+=("$1"); shift;;
    esac
done
set -- "${args[@]}"
cmd="${1:-status}"; shift || true

[ -n "$DIR" ] || { [ -n "$OVERLAY" ] && DIR="$(dirname "$OVERLAY")/.vmkit" || DIR="$PWD/.vmkit"; }
# One canonical spelling, so `up` and `down` agree on -pidfile (d, ./d, /abs/d).
DIR="$(realpath -m "$DIR")"
mkdir -p "$DIR"
QMP_SOCK="$DIR/qmp.sock"; QMP_REC_SOCK="$DIR/qmp-rec.sock"; SERIAL_LOG="$DIR/serial.log"; PIDFILE="$DIR/qemu.pid"
KNOWN="$DIR/known_hosts"; VNCFILE="$DIR/vnc"
REC_PID="$DIR/record.pid"; REC_RUN="$DIR/record.run"
# Host-side python helpers (stdlib) live in <repo>/lib/vmkit.
VMKIT_LIB="$(cd "$(dirname "$(readlink -f "$0")")/../lib" && pwd)"
# Scratch for raw screendumps: tmpfs when available (a 1280x800 PPM is ~3 MB).
if [ -n "${VMKIT_TMP:-}" ]; then TMPD="$VMKIT_TMP"
elif [ -d /dev/shm ] && [ -w /dev/shm ]; then TMPD=/dev/shm
else TMPD="$DIR"; fi

# ---- QMP helper: negotiate, run one command, print the reply object ----------
# Prints the reply object on stdout. An {"error":...} reply (or no reply) also
# prints "vmkit: qmp error: <class>: <desc>" on stderr and exits 1, so a bad
# command (e.g. an invalid qcode) fails the vmkit call instead of "succeeding".
# Socket timeout: VMKIT_QMP_TIMEOUT seconds (default 30).
qmp() {
    python3 - "$QMP_SOCK" "$1" "${VMKIT_QMP_TIMEOUT:-30}" <<'PY'
import json, socket, sys
sp, cmd, to = sys.argv[1], sys.argv[2], float(sys.argv[3])
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(to); s.connect(sp)
f = s.makefile("rwb", buffering=0); f.readline()
f.write(b'{"execute":"qmp_capabilities"}\n'); f.readline()
f.write((cmd + "\n").encode())
while True:
    line = f.readline()
    if not line:
        sys.exit("vmkit: qmp error: connection closed before a reply")
    o = json.loads(line)
    if "return" in o or "error" in o:
        print(json.dumps(o))
        if "error" in o:
            e = o["error"]
            sys.exit(f"vmkit: qmp error: {e.get('class','')}: {e.get('desc','')}")
        break
PY
}

# HMP through QMP's human-monitor-command (savevm/loadvm/info are HMP-only on
# modern QEMU). HMP reports failures as text inside "return", not as a QMP
# error, so: hmp <line> [strict]. Prints the text. Exits 1 on a QMP error, on
# text starting "Error", or (strict=1, for savevm/loadvm, which print nothing
# on success) on any output at all.
hmp() {
    local line="$1" strict="${2:-0}" req out
    req=$(python3 -c 'import json,sys; print(json.dumps({"execute":"human-monitor-command","arguments":{"command-line":sys.argv[1]}}))' "$line")
    out=$(qmp "$req") || return 1
    python3 - "$out" "$strict" "$line" <<'PY'
import json, sys
o = json.loads(sys.argv[1]); strict = sys.argv[2] == "1"
txt = o.get("return", "")
txt = txt if isinstance(txt, str) else ""
if (strict and txt.strip()) or txt.lstrip().lower().startswith("error"):
    sys.exit(f"vmkit: hmp {sys.argv[3]!r} failed: {txt.strip()}")
sys.stdout.write(txt)
PY
}

# Priority prefix for long-lived host processes (qemu, recorder). ionice is
# probed first (called by up/record start only): a class can be denied, e.g.
# -c1 without CAP_SYS_ADMIN, and a failing ionice would never exec qemu.
prio=(nice -n "$NICE")
add_ionice() {
    [ "$IONICE" != none ] && command -v ionice >/dev/null || return 0
    if ionice -c "$IONICE" true 2>/dev/null; then prio+=(ionice -c "$IONICE")
    else echo "vmkit: ionice -c $IONICE is not permitted here; running without ionice" >&2; fi
}

SSH_OPTS=(-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN"
          -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=3
          -o BatchMode=yes)
ssh_argv=(ssh "${SSH_OPTS[@]}" -p "$SSH_PORT" -i "$SSH_KEY" "$SSH_USER@127.0.0.1")
guest_ssh() { "${ssh_argv[@]}" "$@"; }
# ssh joins its argv with spaces into ONE remote command string, which loses
# quoting. remote_cmd rebuilds that string: a single argument is taken as a
# shell command line as-is (`ssh 'journalctl -b | tail'`); two or more are an
# argv and each is quoted with printf %q (`ssh printf '%s\n' 'a b'`).
remote_cmd() {
    if [ $# -eq 1 ]; then printf '%s' "$1"; else printf '%q ' "$@"; fi
}
# Run in the guest's graphical (systemd --user) session: a single-quoted
# env-resolver prefix + the caller's command (see remote_cmd).
xexec_cmd() {
    printf '%s' 'export XDG_RUNTIME_DIR=/run/user/$(id -u); eval "$(systemctl --user show-environment 2>/dev/null | grep -E "^(WAYLAND_DISPLAY|DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|DBUS_SESSION_BUS_ADDRESS|XDG_CURRENT_DESKTOP)=" | sed "s/^/export /")"; '"$(remote_cmd "$@")"
}
guest_xexec() { guest_ssh "$(xexec_cmd "$@")"; }
guest_scp() { scp "${SSH_OPTS[@]}" -P "$SSH_PORT" -i "$SSH_KEY" "$@"; }

# Bounded poll instead of ad-hoc `for i in seq … sleep` loops. Prints nothing;
# exit 0 on success, 1 on timeout. Uses the shell's own clock via a counter
# (agent shells often block foreground `sleep`, so keep intervals coarse).
poll() {  # poll <timeout_s> <interval_s> <cmd...>
    local timeout="$1" interval="$2"; shift 2
    local waited=0
    while ! "$@" >/dev/null 2>&1; do
        [ "$waited" -ge "$timeout" ] && return 1
        sleep "$interval" 2>/dev/null || command sleep "$interval" 2>/dev/null || :
        waited=$((waited + interval))
    done
    return 0
}

# Overlay a coordinate grid + axis labels so pixel targets can be read off a
# screenshot instead of guessed. Lines every 100px, labels every 200px.
grid_overlay() {  # grid_overlay <in.png> <out.png>
    command -v magick >/dev/null || { echo "$1"; return; }
    local in="$1" out="$2"
    read -r W H < <(python3 - "$in" <<'PY'
import struct,sys
d=open(sys.argv[1],'rb').read(24)
print(*struct.unpack('>II',d[16:24])) if d[:8]==b'\x89PNG\r\n\x1a\n' else print(1280,800)
PY
)
    local mvg; mvg="$(python3 - "$W" "$H" <<'PY'
import sys
W,H=int(sys.argv[1]),int(sys.argv[2]); out=[]
for x in range(0,W,100):
    out.append(f"line {x},0 {x},{H}")
    if x%200==0: out.append(f"text {x+2},14 '{x}'")
for y in range(0,H,100):
    out.append(f"line 0,{y} {W},{y}")
    if y%200==0: out.append(f"text 2,{y+14} '{y}'")
print("\n".join(out))
PY
)"
    magick "$in" -stroke 'rgba(255,64,64,0.35)' -strokewidth 1 -fill none \
        -draw "$(printf '%s' "$mvg" | grep '^line')" \
        -stroke none -fill 'rgba(255,80,80,0.9)' -pointsize 13 -font DejaVu-Sans-Mono \
        -draw "$(printf '%s' "$mvg" | grep '^text')" \
        "$out" 2>/dev/null && echo "$out" || echo "$in"
}

# Screendump as PPM. QEMU's PNG encoder runs inside QEMU (~30 ms per call) and
# stalls the guest's display (halves its frame rate); PPM is a memcpy. Callers
# convert on the host when they need PNG. QEMU < 7.1 has no "format" argument
# but writes PPM by default, so fall back to that.
dump_ppm() {  # dump_ppm <out.ppm>
    qmp "$(printf '{"execute":"screendump","arguments":{"filename":"%s","format":"ppm"}}' "$1")" >/dev/null 2>&1 \
        || qmp "$(printf '{"execute":"screendump","arguments":{"filename":"%s"}}' "$1")" >/dev/null
}

# frame_diff <prev.ppm> <cur.ppm>: pixels that differ (magick compare -fuzz 4%;
# it exits 1 when they differ, 2 on error: not fatal here). Prints "size" when
# the resolutions differ (IM 7.1.2 compares two sizes as "0 (0)", exit 0, so
# the PPM headers are compared first) and "error" when compare prints no number.
frame_diff() {
    [ "$(head -n 2 "$1")" = "$(head -n 2 "$2")" ] || { echo size; return 0; }
    local d
    d=$( { magick compare -metric AE -fuzz 4% "$1" "$2" null: 2>&1 || true; } | awk 'NR==1 && $1 ~ /^[0-9.e+]+$/ {print int($1)}')
    echo "${d:-error}"
}

# Append a non-input command (e.g. shot) to the session transcript
# ($DIR/actions.jsonl). Input actions are logged, with timestamps, by act.py.
log_action() {
    python3 -c 'import json, sys, time
print(json.dumps({"t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "cmd": sys.argv[1],
                  "args": " ".join(sys.argv[2:]).rstrip(" ")}))' "$@" \
        >> "$DIR/actions.jsonl" 2>/dev/null || true
}

# Input actions run in lib/vmkit/act.py, which stamps each one on the host's
# CLOCK_MONOTONIC (t_send before the first QMP write, t_ack after the last
# reply) and appends it to actions.jsonl (and to the active recording's run
# dir). Pointer pixels map to the abs axis using the live framebuffer size.
act() { python3 "$VMKIT_LIB/vmkit/act.py" --dir "$DIR" --sock "$QMP_SOCK" --tmp "$TMPD" "$@"; }
# stamped <name> <shown-args> <argv...>: run a subprocess (stdio inherited),
# stamped and logged the same way.
stamped() { local n="$1" shown="$2"; shift 2; python3 "$VMKIT_LIB/vmkit/act.py" --dir "$DIR" exec "$n" "$shown" -- "$@"; }

# OCR the current screen -> lines of "cx cy text". mode: word (default) or line.
ocr_screen() {
    local mode="${1:-word}" ppm="$TMPD/vmkit-ocr.$$.ppm" rc=0
    { dump_ppm "$ppm" && tesseract "$ppm" - tsv 2>/dev/null | awk -v mode="$mode" -F'\t' '
        NR>1 && $12!="" && $12!=" " {
            if (mode=="line") {
                key=$2"-"$3"-"$4"-"$5   # page-block-par-line
                if (!(key in txt)) { x0[key]=$7; y0[key]=$8 }
                txt[key]=txt[key] (txt[key]==""?"":" ") $12
                x1[key]=$7+$9; y1[key]=($8+$10>y1[key]?$8+$10:y1[key])
            } else { printf "%d %d\t%s\n", $7+$9/2, $8+$10/2, $12 }
        }
        END { if (mode=="line") for (k in txt) printf "%d %d\t%s\n", (x0[k]+x1[k])/2, (y0[k]+y1[k])/2, txt[k] }'; } || rc=$?
    rm -f "$ppm"; return "$rc"
}

case "$cmd" in
up)
    [ -n "$OVERLAY" ] && [ -f "$OVERLAY" ] || { echo "vmkit: --overlay PATH required (got '$OVERLAY')" >&2; exit 2; }
    if [ -S "$QMP_SOCK" ] && qmp '{"execute":"query-status"}' >/dev/null 2>&1; then
        echo "already up (qmp $QMP_SOCK, ssh $SSH_PORT)"; exit 0; fi
    rm -f "$QMP_SOCK" "$QMP_REC_SOCK" "$VNCFILE"; : >"$SERIAL_LOG"
    case "$VIEW" in
        none)      disp=(-display none);;
        gtk)       disp=(-display gtk,show-cursor=on);;
        vnc|vnc:*) n="${VIEW#vnc}"; n="${n#:}"; n="${n:-0}"
                   disp=(-display "vnc=127.0.0.1:$n"); echo "$((5900+n))" >"$VNCFILE";;
        *) echo "vmkit: unknown --view '$VIEW' (none|vnc[:N]|gtk)" >&2; exit 2;;
    esac
    cidata=(); [ -n "$CIDATA" ] && cidata=(-drive if=virtio,file="$CIDATA",format=raw,media=cdrom,read-only=on)
    # Machine/cpu per arch+accel: KVM uses host passthrough; TCG needs a model.
    # Devices differ too: x86 q35 has VGA + a USB controller; aarch64 virt has
    # neither and needs UEFI firmware (pflash) + virtio-gpu/xhci.
    [ "$ACCEL" = kvm ] && cpu=host || cpu=max
    fw=(); gpu=(-vga virtio); usb=(-usb)
    case "$ARCH" in
        x86_64|i386) machine=q35 ;;
        aarch64|arm)
            machine=virt; gpu=(-device virtio-gpu-pci); usb=(-device qemu-xhci)
            # UEFI: readonly code + a per-VM writable vars copy. (Loop, not
            # `ls A B C` — ls exits non-zero on any missing path and pipefail
            # would abort under set -e.)
            code=""; for c in /usr/share/edk2/aarch64/QEMU_EFI.fd /usr/share/AAVMF/AAVMF_CODE.fd /usr/share/edk2/arm/QEMU_EFI.fd; do [ -f "$c" ] && { code="$c"; break; }; done
            vars0=""; for v in /usr/share/edk2/aarch64/QEMU_VARS.fd /usr/share/AAVMF/AAVMF_VARS.fd; do [ -f "$v" ] && { vars0="$v"; break; }; done
            if [ -n "$code" ]; then
                [ -f "$DIR/efivars.fd" ] || { [ -n "$vars0" ] && cp "$vars0" "$DIR/efivars.fd" || truncate -s 64M "$DIR/efivars.fd"; }
                fw=(-drive "if=pflash,format=raw,readonly=on,file=$code"
                    -drive "if=pflash,format=raw,file=$DIR/efivars.fd")
            else echo "vmkit: no aarch64 UEFI firmware found (install edk2-aarch64/AAVMF)" >&2; exit 3; fi ;;
        *) machine=virt ;;
    esac
    add_ionice
    echo "== vmkit up: $(basename "$OVERLAY")  arch=$ARCH accel=$ACCEL  view=$VIEW  serial=$SERIAL_LOG  qmp=$QMP_SOCK  ssh=$SSH_PORT$([ -f "$VNCFILE" ] && echo "  vnc=127.0.0.1:$(cat "$VNCFILE")")"
    "${prio[@]}" "qemu-system-$ARCH" \
        -name "vmkit-$(basename "$OVERLAY" .qcow2)" \
        -machine "$machine,accel=$ACCEL" -cpu "$cpu" -m "$MEM" -smp "$SMP" \
        "${fw[@]}" \
        -drive if=virtio,file="$OVERLAY",discard=unmap,detect-zeroes=unmap \
        "${cidata[@]}" \
        -netdev user,id=net0,hostfwd=tcp:127.0.0.1:"$SSH_PORT"-:22 \
        -device virtio-net-pci,netdev=net0 \
        "${gpu[@]}" "${disp[@]}" \
        -serial file:"$SERIAL_LOG" \
        -qmp unix:"$QMP_SOCK",server,nowait \
        -qmp unix:"$QMP_REC_SOCK",server,nowait \
        -device virtio-tablet-pci "${usb[@]}" -device usb-kbd -audio none \
        -pidfile "$PIDFILE" \
        ${QEMU_EXTRA[@]+"${QEMU_EXTRA[@]}"} &
    echo "   qemu pid $!"
    ;;
status)
    echo "qmp   : $([ -S "$QMP_SOCK" ] && echo "$QMP_SOCK" || echo absent)"
    echo "qmprec: $([ -S "$QMP_REC_SOCK" ] && echo "$QMP_REC_SOCK" || echo absent)"
    echo "ssh   : 127.0.0.1:$SSH_PORT $(ss -ltn 2>/dev/null | grep -q ":$SSH_PORT " && echo listening || echo down)"
    [ -S "$QMP_SOCK" ] && echo "state : $(qmp '{"execute":"query-status"}' 2>/dev/null)"
    guest_ssh 'echo "guest : reachable ($(uname -sr))"' 2>/dev/null || echo "guest : not reachable (yet)"
    ;;
shot)
    log_action shot "$@"
    grid=""; name="shot"
    for a in "$@"; do case "$a" in --grid) grid=1;; *) name="$a";; esac; done
    out="$DIR/${name}.png"; ppm="$TMPD/vmkit-shot.$$.ppm"; rc=0
    { dump_ppm "$ppm" && python3 "$VMKIT_LIB/vmkit/imageio.py" ppm2png "$ppm" "$out" >/dev/null; } || rc=$?
    rm -f "$ppm"; [ "$rc" -eq 0 ] || exit "$rc"
    if [ -n "$grid" ]; then out="$(grid_overlay "$out" "$DIR/${name}-grid.png")"; fi
    echo "$out"
    ;;
find)
    # OCR the screen -> "cx,cy<TAB>text". `find "Shut Down"` filters (case-
    # insensitive substring); bare `find` prints everything. --line groups a
    # whole OCR line (so multi-word labels match); default is per-word.
    command -v tesseract >/dev/null || { echo "vmkit find: tesseract not installed on host" >&2; exit 3; }
    mode=word; q=""
    for a in "$@"; do case "$a" in --line) mode=line;; *) q="$a";; esac; done
    ocr_screen "$mode" | awk -v q="$q" -F'\t' 'q=="" || index(tolower($2),tolower(q))>0 {gsub(/ /,",",$1); print $1"\t"$2}'
    ;;
tap-text)
    # OCR-locate a label and click it. `tap-text "Shut Down" [nth] [button]`.
    # Uses --line grouping so multi-word labels match. Exit 1 if not found.
    command -v tesseract >/dev/null || { echo "vmkit tap-text: tesseract not installed on host" >&2; exit 3; }
    q="${1:?vmkit tap-text \"<label>\" [nth] [button]}"; nth="${2:-1}"; btn="${3:-left}"
    ppm="$TMPD/vmkit-ocr.$$.ppm"; rc=0
    # Match the query as a consecutive run of words within one OCR line and
    # target the bbox of just those words (so adjacent buttons don't merge).
    # tesseract TSV goes to a file: a heredoc script can't also read stdin.
    { dump_ppm "$ppm" && tesseract "$ppm" - tsv >"$DIR/.ocr.tsv" 2>/dev/null; } || rc=$?
    rm -f "$ppm"; [ "$rc" -eq 0 ] || exit "$rc"
    target=$(python3 - "$q" "$nth" "$DIR/.ocr.tsv" <<'PY'
import sys
q=sys.argv[1].lower().split(); nth=int(sys.argv[2])
lines={}
for ln in open(sys.argv[3], encoding="utf-8", errors="replace"):
    p=ln.rstrip("\n").split("\t")
    if len(p)<12 or p[0]=="level" or p[11].strip()=="": continue
    key=(p[1],p[2],p[3],p[4])  # page/block/par/line
    lines.setdefault(key,[]).append((p[11], int(p[6]),int(p[7]),int(p[8]),int(p[9])))  # text,l,t,w,h
hits=[]
for words in lines.values():
    toks=[w[0].lower() for w in words]
    for i in range(len(toks)-len(q)+1):
        if toks[i:i+len(q)]==q:
            run=words[i:i+len(q)]
            l=min(w[1] for w in run); t=min(w[2] for w in run)
            r=max(w[1]+w[3] for w in run); b=max(w[2]+w[4] for w in run)
            hits.append(((l+r)//2,(t+b)//2))
# fall back to substring-in-line if no exact word run
if not hits:
    ql=" ".join(q)
    for words in lines.values():
        joined=" ".join(w[0] for w in words).lower()
        if ql in joined:
            l=min(w[1] for w in words); t=min(w[2] for w in words)
            r=max(w[1]+w[3] for w in words); b=max(w[2]+w[4] for w in words)
            hits.append(((l+r)//2,(t+b)//2))
if len(hits)>=nth: print(f"{hits[nth-1][0]} {hits[nth-1][1]}")
PY
)
    [ -n "$target" ] || { echo "tap-text: no on-screen match for \"$q\"" >&2; exit 1; }
    set -- $target
    act --shown "$q $1 $2" tap-text "$1" "$2" "$btn"
    ;;
move) act move "${1:?vmkit move X Y}" "${2:?vmkit move X Y}" ;;
tap)  act tap "${1:?vmkit tap X Y [btn]}" "${2:?vmkit tap X Y [btn]}" "${3:-left}" ;;
drag) act drag "${1:?vmkit drag X1 Y1 X2 Y2 [btn]}" "${2:?}" "${3:?}" "${4:?}" "${5:-left}" ;;
scroll) act scroll "${1:-down}" "${2:-3}" ;;
click) act click "${1:-left}" ;;
keys)
    [ $# -gt 0 ] || { echo "usage: vmkit keys K [K...]" >&2; exit 2; }
    act keys "$@"
    ;;
type)
    [ $# -gt 0 ] || { echo "usage: vmkit type TEXT" >&2; exit 2; }
    act type "$*"
    ;;
record)
    sub="${1:-status}"; shift || true
    # pid_running: exists and is not a zombie (a dead child of this shell).
    pid_running() { kill -0 "$1" 2>/dev/null && [ "$(awk '{print $3}' "/proc/$1/stat" 2>/dev/null)" != Z ]; }
    # rec_alive (stop/status, possibly long after start): also require the
    # cmdline to name the recorder, so a reused pid is not signalled.
    # (no `| grep -q`: under pipefail its early exit SIGPIPEs the reader)
    rec_alive() { local p c; p=$(cat "$REC_PID" 2>/dev/null) && [ -n "$p" ] && pid_running "$p" || return 1
        c=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null); [[ "$c" == *vmkit-record* ]]; }
    # rec_unstart <run>: a start that got no frame removes what the recorder
    # made there, so a retry with the same --out is not "already has a
    # recording". The logs stay (the error points at them; a retry appends).
    rec_unstart() { rm -f "$REC_PID" "$REC_RUN" "$1/frames.jsonl" "$1/segments.jsonl" "$1/summary.json"
        rmdir "$1/frames" 2>/dev/null || :; }
    case "$sub" in
    start)
        # record start [--fps N] [--out RUNDIR] [--degraded-ms MS]
        fps="${VMKIT_REC_FPS:-30}"; out=""; dms="${VMKIT_REC_DEGRADED_MS:-50}"
        while [ $# -gt 0 ]; do case "$1" in
            --fps) fps="$2"; shift 2;; --out) out="$2"; shift 2;; --degraded-ms) dms="$2"; shift 2;;
            *) echo "usage: vmkit record start [--fps N] [--out RUNDIR] [--degraded-ms MS]" >&2; exit 2;; esac; done
        rec_alive && { echo "vmkit record: already recording to $(cat "$REC_RUN") (pid $(cat "$REC_PID"))" >&2; exit 1; }
        [ -S "$QMP_REC_SOCK" ] || { echo "vmkit record: no $QMP_REC_SOCK (VM not up, or booted by a vmkit without the recorder socket)" >&2; exit 1; }
        command -v ffmpeg >/dev/null || { echo "vmkit record: needs ffmpeg" >&2; exit 3; }
        [ -n "$out" ] || out="$DIR/runs/$(date -u +%Y%m%dT%H%M%SZ)"
        mkdir -p "$out"; out="$(cd "$out" && pwd)"
        [ -e "$out/frames.jsonl" ] && { echo "vmkit record: $out already has a recording" >&2; exit 1; }
        # Own session + stdio to a file: a backgrounded child holding our stdout
        # would block a caller reading it (same footgun as `up`).
        add_ionice
        setsid "${prio[@]}" python3 "$(dirname "$VMKIT_LIB")/bin/vmkit-record" --sock "$QMP_REC_SOCK" \
            --run "$out" --fps "$fps" --degraded-ms "$dms" >>"$out/recorder.out" 2>&1 </dev/null &
        rp=$!; echo "$rp" >"$REC_PID"; echo "$out" >"$REC_RUN"
        # Block until the first frame is stamped, so actions after this are
        # covered. Liveness here is pid-only: $rp is our own child, and until
        # its exec chain (setsid, nice, ionice, python3) completes its cmdline
        # is still this script's (or empty), which rec_alive would reject.
        i=0; while ! [ -s "$out/frames.jsonl" ]; do
            if ! pid_running "$rp"; then rec_unstart "$out"
                echo "vmkit record: recorder exited; see $out/recorder.log $out/recorder.out" >&2
                tail -3 "$out/recorder.log" "$out/recorder.out" >&2 2>/dev/null; exit 1; fi
            if [ "$i" -ge 100 ]; then   # stop it (TERM, then KILL: a hung QMP read ignores TERM)
                kill -TERM "$rp" 2>/dev/null || :
                j=0; while pid_running "$rp" && [ "$j" -lt 20 ]; do sleep 0.1 2>/dev/null || :; j=$((j+1)); done
                pid_running "$rp" && { kill -KILL "$rp" 2>/dev/null || :; }
                j=0; while pid_running "$rp" && [ "$j" -lt 20 ]; do sleep 0.1 2>/dev/null || :; j=$((j+1)); done
                rec_unstart "$out"
                echo "vmkit record: no frame after 10 s; recorder stopped (see $out/recorder.log)" >&2; exit 1; fi
            sleep 0.1 2>/dev/null || :; i=$((i+1)); done
        echo "$out"
        ;;
    stop)
        # TERM, then after VMKIT_REC_STOP_TIMEOUT s (default 30, may be
        # fractional) KILL the recorder's process group (it is a session leader:
        # that includes its ffmpeg), e.g. when a hung QEMU or encoder keeps it
        # from acting on TERM. A clean drain at nice 19 under load can take a
        # while. record.pid/record.run go only once it is gone.
        to="${VMKIT_REC_STOP_TIMEOUT:-30}"
        [[ "$to" =~ ^([0-9]+)(\.([0-9]+))?$ ]] || {
            echo "vmkit record: VMKIT_REC_STOP_TIMEOUT must be seconds (e.g. 30 or 2.5), got '$to'" >&2; exit 2; }
        frac="${BASH_REMATCH[3]:-0}"; ticks=$((10#${BASH_REMATCH[1]} * 10 + 10#${frac:0:1}))
        rec_alive || { rm -f "$REC_PID" "$REC_RUN"; echo "vmkit record: not recording" >&2; exit 1; }
        p=$(cat "$REC_PID"); out=$(cat "$REC_RUN")
        kill -TERM "$p" 2>/dev/null || :
        i=0; while pid_running "$p" && [ "$i" -lt "$ticks" ]; do sleep 0.1 2>/dev/null || :; i=$((i+1)); done
        if pid_running "$p"; then
            echo "vmkit record: recorder pid $p ignored SIGTERM for $to s; killed it and its ffmpeg" >&2
            kill -KILL -- "-$p" 2>/dev/null || kill -KILL "$p" 2>/dev/null || :
            i=0; while pid_running "$p" && [ "$i" -lt 50 ]; do sleep 0.1 2>/dev/null || :; i=$((i+1)); done
            pid_running "$p" && { echo "vmkit record: recorder pid $p survives SIGKILL" >&2; exit 1; }
            python3 "$(dirname "$VMKIT_LIB")/bin/vmkit-record" --run "$out" \
                --mark-killed "killed by record stop: no exit $to s after SIGTERM" || :
        fi
        rm -f "$REC_PID" "$REC_RUN"
        echo "$out"
        [ -f "$out/summary.json" ] || { echo "vmkit record: no summary.json; see $out/recorder.log" >&2; exit 1; }
        python3 - "$out/summary.json" <<'PY'
import json, sys
S = json.load(open(sys.argv[1])); iv = S["interval_ms"]; c = S["screendump_call_ms"]
print(f"frames {S['frames']}  fps {S['fps']} (target {S['target_fps']})  interval p50 {iv['p50']} "
      f"p95 {iv['p95']} max {iv['max']} ms  screendump p95 {c['p95']} ms  inactive {S['inactive_frames']}  "
      f"degraded={str(S['degraded']).lower()}" + (f"  ERROR {S['error']}" if S.get("error") else ""))
sys.exit(1 if S.get("error") else 0)
PY
        ;;
    status)
        if rec_alive; then
            out=$(cat "$REC_RUN" 2>/dev/null)
            echo "recording: pid $(cat "$REC_PID")  run $out  frames $(wc -l <"$out/frames.jsonl" 2>/dev/null || echo 0)"
        else echo "not recording"; [ -f "$REC_PID" ] && rm -f "$REC_PID" "$REC_RUN"; exit 1; fi
        ;;
    *) echo "usage: vmkit record start|stop|status" >&2; exit 2;;
    esac
    ;;
frames)  # select recorded frames by anchor + offset (lib/vmkit/timeline.py)
    python3 "$VMKIT_LIB/vmkit/timeline.py" --dir "$DIR" "$@" ;;
check)   # model-free checks on recorded frames (bin/vmkit-check)
    python3 "$(dirname "$VMKIT_LIB")/bin/vmkit-check" "$@" --dir "$DIR" ;;
report)  # report.html for a run dir (lib/vmkit/report.py)
    python3 "$(dirname "$VMKIT_LIB")/bin/vmkit-report" --dir "$DIR" "$@" ;;
view)
    # Shared live view for the human, alongside the agent's QMP control of the
    # same VM. Requires the VM to have been started with --view vnc[:N].
    [ -f "$VNCFILE" ] || { echo "no VNC view active — start with: vmkit up --view vnc" >&2; exit 1; }
    port=$(cat "$VNCFILE"); addr="127.0.0.1:$port"
    echo "VNC: $addr  (display :$((port-5900)))"
    if [ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        echo "no local display in this shell — connect a viewer from your desktop:"
        echo "  remote-viewer vnc://$addr   # or vinagre/gvncviewer/wlvncc/vncviewer"
        exit 0
    fi
    for c in remote-viewer vinagre gvncviewer wlvncc vncviewer; do
        if command -v "$c" >/dev/null; then
            case "$c" in
                remote-viewer) exec "$c" "vnc://$addr";;
                gvncviewer)    exec "$c" "$addr";;
                wlvncc)        exec "$c" 127.0.0.1 "$port";;
                *)             exec "$c" "$addr";;
            esac
        fi
    done
    echo "no VNC client found (tried remote-viewer/vinagre/gvncviewer/wlvncc/vncviewer)" >&2; exit 1
    ;;
wait)
    # Replace ad-hoc poll loops. Subcommands print nothing; exit 0/1.
    what="${1:-ssh}"; shift || true
    case "$what" in
        ssh)   to="${1:-120}"; poll "$to" 3 guest_ssh true \
                   && echo "ssh up" || { echo "timed out ($to s) waiting for ssh" >&2; exit 1; };;
        exec)  cmd="${1:?vmkit wait exec \"<cmd>\"}"; to="${2:-120}"
               poll "$to" 3 guest_ssh "$cmd" \
                   && echo "condition met" || { echo "timed out ($to s): $cmd" >&2; exit 1; };;
        xexec) cmd="${1:?vmkit wait xexec \"<cmd>\"}"; to="${2:-120}"   # polled in the graphical session
               poll "$to" 2 guest_xexec "$cmd" \
                   && echo "condition met" || { echo "timed out ($to s): $cmd" >&2; exit 1; };;
        serial) re="${1:?vmkit wait serial <regex>}"; to="${2:-120}"
               poll "$to" 2 grep -Eq "$re" "$SERIAL_LOG" \
                   && echo "serial matched: $re" || { echo "timed out ($to s): serial !~ $re" >&2; exit 1; };;
        screen) to="${1:-60}"; want="${2:-2}"; thresh="${VMKIT_STABLE_PX:-5000}"
               # "Stable" = successive frames differ by fewer than THRESH pixels,
               # so a ticking clock (a few hundred px) doesn't defeat it but a
               # window opening/closing (many thousands) does. Needs magick.
               # A resolution change or a compare error is never stable.
               command -v magick >/dev/null || { echo "vmkit wait screen needs magick" >&2; exit 3; }
               stable=0; waited=0; prev=""
               trap 'rm -f "$TMPD"/vmkit-st.$$.*.ppm' EXIT
               while [ "$waited" -lt "$to" ]; do
                   cur="$TMPD/vmkit-st.$$.$((waited % 2)).ppm"
                   if ! dump_ppm "$cur"; then   # transient (e.g. no surface mid mode-switch): retry
                       rm -f "$cur"; prev=""; stable=0; sleep 1 2>/dev/null || :; waited=$((waited+1)); continue
                   fi
                   if [ -n "$prev" ]; then
                       d=$(frame_diff "$prev" "$cur")
                       if [[ "$d" =~ ^[0-9]+$ ]] && [ "$d" -lt "$thresh" ]; then stable=$((stable+1)); else stable=0; fi
                       [ "$stable" -ge "$want" ] && { echo "screen stable (last diff ${d}px)"; exit 0; }
                   fi
                   prev="$cur"; sleep 1 2>/dev/null || :; waited=$((waited+1))
               done
               echo "timed out ($to s) waiting for a stable frame" >&2; exit 1;;
        *) echo "usage: vmkit wait {ssh|exec <cmd>|xexec <cmd>|serial <regex>|screen} [timeout]" >&2; exit 2;;
    esac
    ;;
push)  # push <local> <guest-dest> — scp then sudo-install (dest may be root-owned)
    src="${1:?vmkit push <local> <guest-dest>}"; dst="${2:?dest required}"
    [ -f "$src" ] || { echo "vmkit push: no such file: $src" >&2; exit 2; }
    mode=$(stat -c '%a' "$src"); tmp="/tmp/.vmkit-push.$$"
    guest_scp "$src" "$SSH_USER@127.0.0.1:$tmp" >/dev/null
    guest_ssh "sudo install -Dm$mode $tmp '$dst' && rm -f $tmp" && echo "pushed $src -> $dst (mode $mode)"
    ;;
pull)  # pull <guest-path> <local>
    gsrc="${1:?vmkit pull <guest-path> <local>}"; ldst="${2:?local dest required}"
    guest_scp "$SSH_USER@127.0.0.1:$gsrc" "$ldst" >/dev/null && echo "pulled $gsrc -> $ldst"
    ;;
xexec)  # run a command inside the guest's graphical (systemd --user) session,
        # resolving XDG_RUNTIME_DIR + WAYLAND_DISPLAY/DISPLAY/etc. so GUI apps
        # launch on the desktop without hand-set env. Generic for Linux guests.
    [ $# -gt 0 ] || { echo "usage: vmkit xexec <cmd...>" >&2; exit 2; }
    stamped xexec "$(remote_cmd "$@")" "${ssh_argv[@]}" "$(xexec_cmd "$@")"
    ;;
watch)  # emit a line whenever the screen changes beyond VMKIT_STABLE_PX, until
        # timeout. Pairs with the harness Monitor for motion-aware waiting.
    command -v magick >/dev/null || { echo "vmkit watch needs magick" >&2; exit 3; }
    to="${1:-120}"; thresh="${VMKIT_STABLE_PX:-5000}"; waited=0; prev=""
    trap 'rm -f "$TMPD"/vmkit-w.$$.*.ppm' EXIT
    while [ "$waited" -lt "$to" ]; do
        cur="$TMPD/vmkit-w.$$.$((waited % 2)).ppm"
        if ! dump_ppm "$cur"; then   # transient: retry next second
            rm -f "$cur"; prev=""; sleep 1 2>/dev/null || :; waited=$((waited+1)); continue
        fi
        if [ -n "$prev" ]; then
            d=$(frame_diff "$prev" "$cur"); what=""
            case "$d" in
                size)  what="changed (resolution)";;
                error) what="changed (compare failed)";;
                *)     [ "$d" -ge "$thresh" ] && what="changed ${d}px";;
            esac
            [ -n "$what" ] && echo "$(date -u +%H:%M:%SZ 2>/dev/null) $what"
        fi
        prev="$cur"; sleep 1 2>/dev/null || :; waited=$((waited+1))
    done
    ;;
overlay)  # overlay new <base> [overlay] | overlay reset [overlay]
    sub="${1:-}"; shift || true
    [ -n "$sub" ] || { echo "usage: vmkit overlay {new <base> [overlay]|reset [overlay]}" >&2; exit 2; }
    case "$sub" in
        new)  base="${1:?overlay new <base> [overlay]}"; ovl="${2:-$OVERLAY}"
              [ -n "$ovl" ] || { echo "overlay path required (--overlay or 2nd arg)" >&2; exit 2; }
              qemu-img create -f qcow2 -F qcow2 -b "$base" "$ovl" >/dev/null && echo "created $ovl (backed by $base)";;
        reset) ovl="${1:-$OVERLAY}"; [ -f "$ovl" ] || { echo "no overlay: $ovl" >&2; exit 2; }
              base=$(qemu-img info "$ovl" | sed -n 's/^backing file: //p' | head -1)
              [ -n "$base" ] || { echo "overlay has no backing file; refusing to reset $ovl" >&2; exit 2; }
              rm -f "$ovl"; qemu-img create -f qcow2 -F qcow2 -b "$base" "$ovl" >/dev/null && echo "reset $ovl (from $base)";;
        *) echo "usage: vmkit overlay {new <base> [overlay]|reset [overlay]}" >&2; exit 2;;
    esac
    ;;
image)  # image pull <url> [dest] — fetch a base cloud image
    [ "${1:-}" = pull ] || { echo "usage: vmkit image pull <url> [dest]" >&2; exit 2; }
    url="${2:?image pull <url> [dest]}"; dest="${3:-$(basename "$url")}"
    command -v curl >/dev/null || { echo "vmkit image pull needs curl" >&2; exit 3; }
    curl -fL "$url" -o "$dest" && echo "pulled $dest"
    ;;
serial) tail -n "${1:-60}" "$SERIAL_LOG" ;;
ssh)    if [ $# -eq 0 ]; then guest_ssh; else stamped ssh "$(remote_cmd "$@")" "${ssh_argv[@]}" "$(remote_cmd "$@")"; fi ;;
qmp)    qmp "$1" ;;
hmp)    hmp "$*" ;;
snapshots) hmp "info snapshots" ;;
# savevm/loadvm write/read the whole RAM image and can outlast the 30 s default
# socket timeout, so they get VMKIT_SNAPSHOT_TIMEOUT (default 600 s).
snapshot) n="${1:?vmkit snapshot NAME}"
          VMKIT_QMP_TIMEOUT="${VMKIT_SNAPSHOT_TIMEOUT:-600}" hmp "savevm $n" 1 && echo "snapshot $n saved" ;;
restore)  n="${1:?vmkit restore NAME}"
          # QEMU stops the VM for loadvm and restarts it only if it was running.
          # A FAILED loadvm leaves it stopped in "restore-vm", so a later good
          # loadvm would not restart it either: treat restore-vm as "was running".
          runstate() { qmp '{"execute":"query-status"}' | python3 -c 'import json,sys; print(json.load(sys.stdin)["return"]["status"])'; }
          before=$(runstate)
          if VMKIT_QMP_TIMEOUT="${VMKIT_SNAPSHOT_TIMEOUT:-600}" hmp "loadvm $n" 1; then
              after=$(runstate)
              if [ "$after" != running ] && { [ "$before" = running ] || [ "$before" = restore-vm ]; }; then
                  qmp '{"execute":"cont"}' >/dev/null; fi
              echo "restored $n"
          else
              [ "$(runstate)" = running ] || echo "vmkit restore: the VM is left stopped (QEMU does that after a failed loadvm); restore another snapshot, or resume with: vmkit qmp '{\"execute\":\"cont\"}'" >&2
              exit 1
          fi ;;
down)
    # Wait on the qemu process itself, not on the ssh port (slirp keeps the
    # forwarded port listening for as long as qemu runs, guest or no guest).
    # qemu deletes its pidfile on exit, so read the pid before powering down,
    # and only ever signal it while its cmdline is still THIS VM's qemu (its
    # -pidfile is ours: pid reuse, other VMs). A running recorder is stopped
    # first so it writes its summary.
    if [ -f "$REC_PID" ]; then "$0" --dir "$DIR" record stop || true; fi
    P=$(cat "$PIDFILE" 2>/dev/null || true)
    qemu_alive() { local c; [ -n "$P" ] && kill -0 "$P" 2>/dev/null && c=$(tr '\0' ' ' <"/proc/$P/cmdline" 2>/dev/null) && [[ "$c" == *qemu-system*" -pidfile $PIDFILE "* ]]; }
    qmp_alive() { [ -S "$QMP_SOCK" ] && qmp '{"execute":"query-status"}' >/dev/null 2>&1; }
    wait_gone() {  # wait_gone <seconds>
        local i=0; while qemu_alive; do [ "$i" -ge "$1" ] && return 1; sleep 1 2>/dev/null || :; i=$((i+1)); done
    }
    [ -S "$QMP_SOCK" ] && qmp '{"execute":"system_powerdown"}' >/dev/null 2>&1 || true
    if qemu_alive; then
        if ! wait_gone "${VMKIT_DOWN_TIMEOUT:-60}"; then
            echo "vmkit down: guest ignored powerdown; SIGTERM qemu pid $P" >&2
            kill "$P" 2>/dev/null || true
            if ! wait_gone 10; then echo "vmkit down: SIGKILL qemu pid $P" >&2; kill -9 "$P" 2>/dev/null || true; wait_gone 5 || true; fi
        fi
    else
        # No live pid to wait on (no/empty/stale pidfile): wait for QMP to stop answering.
        i=0; while qmp_alive; do
            if [ "$i" -ge "${VMKIT_DOWN_TIMEOUT:-60}" ]; then
                echo "vmkit down: state unknown: no qemu pid in $PIDFILE, and QEMU still answers on $QMP_SOCK after powerdown (nothing signalled; vmkit qmp '{\"execute\":\"quit\"}' stops it)" >&2
                exit 1; fi
            sleep 1 2>/dev/null || :; i=$((i+1)); done
    fi
    qemu_alive || rm -f "$PIDFILE"      # qemu leaves it behind when SIGKILLed
    rm -f "$QMP_SOCK" "$QMP_REC_SOCK"; echo "down"
    ;;
*) sed -n '2,/^set -euo pipefail/p' "$0" | sed '$d'; exit 2 ;;
esac
